# One hosted model; no Qdrant, Hugging Face or local GPU required by the application.
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
SQLAGENT_MAX_ROWS=1000
SQLAGENT_QUERY_SECONDS=10
SQLAGENT_UPLOAD_MB=150
# Optional persistent local runtime directory. Free-host local files are ephemeral.
# SQLAGENT_DATA_DIR=/absolute/path/to/runtime
